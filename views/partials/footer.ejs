<a class="support-fab" data-support-launch href="/support" aria-label="Help or report bugs" title="Help or report bugs">
  <span class="icon-svg"><%- iconSvg("help") %></span>
  <span class="support-fab-label">Help</span>
</a>

<script>
  if (document.querySelector(".profile-page-public .profile-mobile-dock")) {
    document.body.classList.add("has-profile-mobile-dock");
  }

  if (document.querySelector(".studio-actions")) {
    document.body.classList.add("has-studio-action-dock");
  }

  document.querySelectorAll("[data-support-launch]").forEach((link) => {
    const currentPath = `${window.location.pathname}${window.location.search}`;
    link.setAttribute("href", `/support?from=${encodeURIComponent(currentPath)}`);
  });

  document.querySelectorAll("[data-template-choice]").forEach((button) => {
    const form = button.closest("form");
    const input = form?.querySelector("[data-starter-template-input]");
    if (!form || !input) {
      return;
    }

    button.addEventListener("click", () => {
      input.value = button.dataset.templateChoice || "service";
      form.querySelectorAll("[data-template-choice]").forEach((choice) => {
        choice.classList.toggle("is-active", choice === button);
      });
    });
  });

  document.querySelectorAll("[data-username-check]").forEach((input) => {
    const form = input.closest("form");
    const status = form?.querySelector("[data-username-status]");
    let timer = null;
    let requestNumber = 0;

    const setStatus = (message, state = "") => {
      if (!status) {
        return;
      }
      status.textContent = message || "";
      status.classList.remove("is-good", "is-bad", "is-muted");
      if (state) {
        status.classList.add(state);
      }
    };

    const checkUsername = async () => {
      const value = input.value.trim();
      requestNumber += 1;
      const currentRequest = requestNumber;

      if (!value) {
        setStatus("", "");
        return;
      }

      setStatus("Checking username...", "is-muted");
      try {
        const response = await fetch(`/api/username/${encodeURIComponent(value)}`, {
          headers: { "Accept": "application/json" }
        });
        const result = await response.json();
        if (currentRequest !== requestNumber) {
          return;
        }
        setStatus(result.message || "", result.available ? "is-good" : "is-bad");
      } catch (error) {
        if (currentRequest === requestNumber) {
          setStatus("Could not check that username right now.", "is-bad");
        }
      }
    };

    input.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(checkUsername, 280);
    });

    input.addEventListener("blur", checkUsername);

    if (input.value.trim()) {
      checkUsername();
    }
  });

  const starterTemplateNode = document.getElementById("starter-template-data");
  if (starterTemplateNode) {
    let starterTemplates = [];
    try {
      starterTemplates = JSON.parse(starterTemplateNode.textContent || "[]");
    } catch (error) {
      starterTemplates = [];
    }

    document.querySelectorAll("[data-apply-starter]").forEach((button) => {
      button.addEventListener("click", () => {
        const template = starterTemplates.find((item) => item.value === button.dataset.applyStarter);
        const form = button.closest("form");
        if (!template || !form) {
          return;
        }

        const setValue = (selector, value) => {
          const field = form.querySelector(selector);
          if (!field) {
            return;
          }
          if (field.type === "checkbox") {
            field.checked = Boolean(value);
          } else {
            field.value = value || "";
          }
          field.dispatchEvent(new Event("change", { bubbles: true }));
        };

        setValue("[name='bio']", template.bio);
        setValue("[name='theme']", template.theme);
        setValue("[name='accent_color']", template.accent_color);
        setValue("[name='lead_form_enabled']", template.lead_form_enabled);
        setValue("[name='lead_form_prompt']", template.lead_form_prompt);

        const rows = Array.from(form.querySelectorAll("[data-link-row]"));
        (template.links || []).forEach((link, index) => {
          const row = rows[index];
          if (!row) {
            return;
          }

          row.classList.remove("is-hidden-empty");
          const section = row.querySelector("[name='link_section']");
          const label = row.querySelector("[name='link_label']");
          const url = row.querySelector("[name='link_url']");
          if (section) {
            section.value = link.section || "featured";
          }
          if (label) {
            label.value = link.label || "";
          }
          if (url) {
            url.value = "";
            const placeholder = String(link.placeholder || "");
            const needsScheme = placeholder && !placeholder.includes("@") && !placeholder.startsWith("+") && !/^[a-z]+:/i.test(placeholder);
            url.placeholder = placeholder ? `${needsScheme ? "https://" : ""}${placeholder}` : "https://yourdomain.com";
          }
        });

        form.querySelectorAll("[data-apply-starter]").forEach((choice) => {
          choice.classList.toggle("is-active", choice === button);
        });
      });
    });
  }

  document.querySelectorAll("[data-link-builder]").forEach((builder) => {
    const revealButton = builder.querySelector("[data-reveal-links]");
    const rows = Array.from(builder.querySelectorAll("[data-link-row]"));
    const tools = builder.querySelector(".link-builder-tools");
    let draggedRow = null;

    const syncRevealButton = () => {
      if (!revealButton) {
        return;
      }

      const hiddenRows = rows.filter((row) => row.classList.contains("is-hidden-empty"));
      revealButton.hidden = hiddenRows.length === 0;
    };

    revealButton?.addEventListener("click", () => {
      rows
        .filter((row) => row.classList.contains("is-hidden-empty"))
        .slice(0, 4)
        .forEach((row) => row.classList.remove("is-hidden-empty"));

      syncRevealButton();
      syncDragState();
    });

    const getVisibleRows = () => rows.filter((row) => !row.classList.contains("is-hidden-empty"));

    const syncDragState = () => {
      rows.forEach((row) => {
        const handle = row.querySelector("[data-link-drag-handle]");
        const canDrag = !row.classList.contains("is-hidden-empty");
        row.removeAttribute("draggable");
        row.classList.remove("is-dragging");

        if (handle) {
          handle.hidden = !canDrag;
          handle.disabled = !canDrag;
        }
      });
    };

    const getDragAfterElement = (clientY) => {
      return getVisibleRows()
        .filter((row) => row !== draggedRow)
        .reduce((closest, row) => {
          const box = row.getBoundingClientRect();
          const offset = clientY - box.top - (box.height / 2);

          if (offset < 0 && offset > closest.offset) {
            return { offset, element: row };
          }

          return closest;
        }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
    };

    rows.forEach((row) => {
      const handle = row.querySelector("[data-link-drag-handle]");
      const enableDragging = () => {
        if (!row.classList.contains("is-hidden-empty")) {
          row.setAttribute("draggable", "true");
        }
      };
      const disableDragging = () => {
        row.removeAttribute("draggable");
      };

      handle?.addEventListener("mousedown", enableDragging);
      handle?.addEventListener("touchstart", enableDragging, { passive: true });
      handle?.addEventListener("mouseup", disableDragging);
      handle?.addEventListener("mouseleave", disableDragging);
      handle?.addEventListener("touchend", disableDragging);

      row.addEventListener("dragstart", (event) => {
        if (row.classList.contains("is-hidden-empty")) {
          event.preventDefault();
          return;
        }

        draggedRow = row;
        row.classList.add("is-dragging");
        if (event.dataTransfer) {
          event.dataTransfer.effectAllowed = "move";
          event.dataTransfer.setData("text/plain", row.querySelector("input[name='link_label']")?.value || "link");
        }
      });

      row.addEventListener("dragend", () => {
        disableDragging();
        row.classList.remove("is-dragging");
        draggedRow = null;
      });
    });

    builder.addEventListener("dragover", (event) => {
      if (!draggedRow) {
        return;
      }

      event.preventDefault();
      const afterElement = getDragAfterElement(event.clientY);
      if (afterElement) {
        builder.insertBefore(draggedRow, afterElement);
      } else if (tools) {
        builder.insertBefore(draggedRow, tools);
      } else {
        builder.appendChild(draggedRow);
      }
    });

    syncRevealButton();
    syncDragState();
  });

  document.querySelectorAll("[data-share-page]").forEach((button) => {
    const defaultLabel = button.querySelector("[data-share-label]");
    const url = button.dataset.shareUrl || window.location.href;
    const title = button.dataset.shareTitle || document.title;
    const text = button.dataset.shareText || `Check out ${title}`;

    const flashLabel = (nextText) => {
      if (!defaultLabel) {
        return;
      }

      const original = defaultLabel.textContent;
      defaultLabel.textContent = nextText;

      window.setTimeout(() => {
        defaultLabel.textContent = original;
      }, 1600);
    };

    button.addEventListener("click", async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, text, url });
          flashLabel("Shared");
          return;
        } catch (error) {
          if (error && error.name === "AbortError") {
            return;
          }
        }
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        try {
          await navigator.clipboard.writeText(url);
          flashLabel("Copied");
          return;
        } catch (error) {
        }
      }

      window.prompt("Copy this page link", url);
    });
  });
</script>
</body>
</html>
