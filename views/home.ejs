<%- include("partials/header") %>

<div class="site-shell">
  <header class="marketing-nav container">
    <a class="brand-mark" href="/">myurlc.com</a>
    <div class="nav-actions">
      <% if (currentCustomer) { %>
        <a class="btn btn-ghost" href="<%= currentCustomer.can_access_studio ? '/studio' : '/billing' %>"><%= currentCustomer.can_access_studio ? 'Open Studio' : 'Billing' %></a>
        <form method="POST" action="/logout">
          <button class="btn btn-secondary" type="submit">Log Out</button>
        </form>
      <% } else { %>
        <a class="btn btn-ghost" href="/login">Log In</a>
        <a class="btn" href="/signup">Start free</a>
      <% } %>
    </div>
  </header>

  <main class="container">
    <section class="card hero-card">
      <div class="hero-copy">
        <div class="founder-banner">
          <div class="founder-banner-topline">
            <span class="founder-chip">Founder 500</span>
            <span class="founder-count"><%= founderOffer.claimed %> / <%= founderOffer.limit %> claimed</span>
          </div>
          <strong>Free for the first 500 users for life!</strong>
          <p>
            <%= founderOffer.is_open
              ? `${founderOffer.remaining} founder spot${founderOffer.remaining === 1 ? "" : "s"} left. Early users get lifetime access automatically.`
              : `The founder offer is closed, but new users can still start with a ${trialDays}-day free trial.` %>
          </p>
        </div>
        <p class="eyebrow">Link in bio plus lead capture</p>
        <h1>One bio link that turns visitors into customers.</h1>
        <p class="lead">
          Build a branded page for your offers, booking links, socials, email list, and lead form.
          Share one clean URL everywhere and see what actually gets clicks.
        </p>
        <form class="claim-form" method="GET" action="/signup">
          <label for="homepage-slug">Claim your free page URL</label>
          <input type="hidden" name="template" value="service" data-starter-template-input />
          <div class="claim-input-shell claim-input-shell-large">
            <span>myurlc.com/</span>
            <input id="homepage-slug" name="slug" placeholder="your-brand" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" minlength="3" maxlength="32" autocapitalize="off" spellcheck="false" data-username-check required />
            <button class="btn" type="submit">Claim it</button>
          </div>
          <p class="username-status" data-username-status aria-live="polite"></p>
          <div class="starter-picker" aria-label="Choose a starter page type">
            <% starterTemplateOptions.forEach(option => { %>
              <button class="starter-choice <%= option.value === 'service' ? 'is-active' : '' %>" type="button" data-template-choice="<%= option.value %>">
                <strong><%= option.label %></strong>
                <span><%= option.description %></span>
              </button>
            <% }) %>
          </div>
          <p class="field-hint">No credit card needed. Pick a starter, then edit everything before publishing.</p>
        </form>
        <div class="actions">
          <a class="btn btn-secondary" href="<%= currentCustomer ? (currentCustomer.can_access_studio ? '/studio' : '/billing') : '/signup' %>"><%= currentCustomer ? (currentCustomer.can_access_studio ? 'Open your studio' : 'Upgrade your account') : 'Start without picking a URL' %></a>
          <a class="btn btn-secondary" href="/buy">Need a done-for-you setup?</a>
        </div>
        <div class="hero-badges">
          <span><%= founderOffer.is_open ? `${founderOffer.remaining} founder spots left` : "Founder offer closed" %></span>
          <span>Lead capture built in</span>
          <span>Analytics included</span>
          <span>SEO-friendly public pages</span>
        </div>

        <div class="announcement-card">
          <p class="announcement-label">Why people join</p>
          <div class="announcement-feed">
            <% if (recentSignups && recentSignups.length > 0) { %>
              <% recentSignups.slice(0, 3).forEach(item => { %>
                <div class="announcement-item">
                  <strong><%= item.business_name %></strong>
                  <span><%= item.relative_created_at %></span>
                </div>
              <% }) %>
            <% } else { %>
              <div class="announcement-item">
                <strong>Founder spots are open now</strong>
                <span>Start free today</span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="hero-preview">
        <div class="phone-frame">
          <div class="phone-card">
            <div class="phone-avatar"></div>
            <p class="phone-title">Maya Bloom Studio</p>
            <p class="phone-copy">Bookings, offers, social links, and a lead form in one fast mobile page.</p>
            <div class="phone-link">Book now</div>
            <div class="phone-link phone-link-alt">Join email list</div>
            <div class="phone-link phone-link-soft">Send a message</div>
          </div>
        </div>
      </div>
    </section>

    <section class="grid three conversion-grid">
      <article class="card">
        <p class="card-number">For creators</p>
        <h2>Send fans to the right next step.</h2>
        <p>Highlight your latest video, podcast, shop, music, newsletter, or booking link without making people hunt.</p>
      </article>
      <article class="card">
        <p class="card-number">For local businesses</p>
        <h2>Capture leads, not just clicks.</h2>
        <p>Turn profile visits into names, emails, phone interest, and messages you can actually follow up on.</p>
      </article>
      <article class="card">
        <p class="card-number">For service pros</p>
        <h2>Make one page your mini website.</h2>
        <p>Use a clean URL, profile media, buttons, sections, and analytics to send every visitor toward an action.</p>
      </article>
    </section>

    <section class="card">
      <div class="section-header">
        <div>
          <p class="eyebrow">Why switch</p>
          <h2>Built for action, not just a menu of links.</h2>
        </div>
        <a class="text-link" href="/signup">Claim your page</a>
      </div>
      <div class="comparison-grid">
        <div class="comparison-column">
          <span class="comparison-label">Typical bio link</span>
          <div class="comparison-item">A list of buttons</div>
          <div class="comparison-item">Basic clicks</div>
          <div class="comparison-item">Generic page templates</div>
          <div class="comparison-item">Visitors leave without sharing contact info</div>
        </div>
        <div class="comparison-column comparison-column-featured">
          <span class="comparison-label">myurlc.com</span>
          <div class="comparison-item">Buttons, socials, sections, and media</div>
          <div class="comparison-item">Views, clicks, leads, and top links</div>
          <div class="comparison-item">Search-friendly public profile pages</div>
          <div class="comparison-item">Built-in lead form for follow-up</div>
        </div>
      </div>
    </section>

    <section class="grid two social-proof-grid">
      <article class="card">
        <div class="section-header">
          <div>
            <p class="eyebrow">Just joined</p>
            <h2>Show visitors real momentum.</h2>
          </div>
        </div>
        <div class="signup-proof-list">
          <% if (!recentSignups || recentSignups.length === 0) { %>
            <div class="empty-state">
              <h3>Founder spots are still open</h3>
              <p>Be one of the first featured pages and lock in the founder offer while it is still available.</p>
            </div>
          <% } %>

          <% (recentSignups || []).forEach(item => { %>
            <article class="signup-proof-item">
              <div>
                <strong><%= item.business_name %></strong>
                <p><%= item.message %></p>
              </div>
              <span><%= item.relative_created_at %></span>
            </article>
          <% }) %>
        </div>
      </article>

      <article class="card">
        <div class="section-header">
          <div>
            <p class="eyebrow">Referral loop</p>
            <h2>Invite friends and earn free months.</h2>
          </div>
        </div>
        <div class="feature-list">
          <div class="feature-item">Every account gets a shareable referral link</div>
          <div class="feature-item">Each successful referral earns 1 free month</div>
          <div class="feature-item">Rewards stack up to 12 months of free service</div>
        </div>
        <a class="btn" href="<%= currentCustomer ? '/billing' : '/signup' %>"><%= currentCustomer ? 'Open referral tools' : 'Start your page' %></a>
      </article>
    </section>

    <section class="grid three">
      <article class="card">
        <p class="card-number">01</p>
        <h2>Claim a username</h2>
        <p>Start with a clean public URL like <strong>myurlc.com/username</strong> and keep it easy to share.</p>
      </article>
      <article class="card">
        <p class="card-number">02</p>
        <h2>Add your best actions</h2>
        <p>Add offers, socials, booking links, a store, newsletter, phone link, or contact form in one place.</p>
      </article>
      <article class="card">
        <p class="card-number">03</p>
        <h2>Learn what works</h2>
        <p>Use analytics to see which links people click and which pages turn visitors into leads.</p>
      </article>
    </section>

    <section class="card">
      <div class="section-header">
        <div>
          <p class="eyebrow">Template ideas</p>
          <h2>Start from a page that matches your audience</h2>
        </div>
        <a class="text-link" href="/signup">Build one now</a>
      </div>

      <div class="template-grid">
        <% starterTemplateOptions.forEach(option => { %>
          <a class="template-card theme-<%= option.theme %>-demo" href="/signup?template=<%= option.value %>">
            <span><%= option.label %></span>
            <strong><%= option.description %></strong>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="card pricing-highlight">
      <div>
        <p class="eyebrow">Simple start</p>
        <h2>Free to launch while founder spots are open.</h2>
        <p class="section-copy">
          Claim a page, publish links, collect leads, and watch your analytics before you decide what to upgrade.
          <%= founderOffer.is_open ? `${founderOffer.remaining} founder spot${founderOffer.remaining === 1 ? "" : "s"} remain for lifetime access.` : `New accounts start with a ${trialDays}-day trial.` %>
        </p>
      </div>
      <a class="btn" href="/signup">Start free</a>
    </section>

    <section class="card">
      <div class="section-header">
        <div>
          <p class="eyebrow">Published examples</p>
          <h2>Pages your customers can share</h2>
        </div>
      </div>

      <div class="grid three">
        <% if (published.length === 0) { %>
          <article class="example-card demo-example-card">
            <strong>Coach or consultant</strong>
            <span>Book a call, collect an email, and send visitors to your best offer.</span>
            <small>myurlc.com/your-coaching-brand</small>
          </article>
          <article class="example-card demo-example-card">
            <strong>Restaurant or local shop</strong>
            <span>Share menu, directions, phone, specials, and an inquiry form.</span>
            <small>myurlc.com/your-local-brand</small>
          </article>
          <article class="example-card demo-example-card">
            <strong>Creator or musician</strong>
            <span>Promote a latest drop, socials, merch, events, and fan signup.</span>
            <small>myurlc.com/your-creator-name</small>
          </article>
        <% } %>

        <% published.forEach(item => { %>
          <a class="example-card" href="<%= item.public_path %>">
            <% if (item.profile_image) { %>
              <img class="example-thumb" src="<%= item.profile_image %>" alt="<%= item.business_name %>" />
            <% } %>
            <strong><%= item.business_name %></strong>
            <span><%= item.bio || "Branded link-in-bio page" %></span>
            <small><%= item.public_url %></small>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="grid three trust-grid">
      <article class="card">
        <h2>No credit card to start</h2>
        <p>Create the page first. Add billing only when your trial or founder status requires it.</p>
      </article>
      <article class="card">
        <h2>Your data is exportable</h2>
        <p>Customer pages include JSON export and lead capture you can follow up with outside the platform.</p>
      </article>
      <article class="card">
        <h2>Help is one click away</h2>
        <p>Use the support form to send bugs, setup questions, or feature requests while the product grows.</p>
      </article>
    </section>
  </main>
</div>

<%- include("partials/footer") %>
