<%- include("partials/header") %>

<div class="site-shell">
  <header class="simple-nav container">
    <a class="brand-mark" href="/">myurlc.com</a>
    <a class="text-link" href="/login">Already have an account?</a>
  </header>

  <main class="container auth-grid">
    <section class="card auth-copy-card">
      <div class="founder-banner founder-banner-compact">
        <div class="founder-banner-topline">
          <span class="founder-chip">Founder 500</span>
          <span class="founder-count"><%= founderOffer.claimed %> / <%= founderOffer.limit %> claimed</span>
        </div>
        <strong>Free for the first 500 users for life!</strong>
        <p>
          <%= founderOffer.is_open
            ? `${founderOffer.remaining} founder spot${founderOffer.remaining === 1 ? "" : "s"} still open right now.`
            : "The founding 500 is full, but you can still start with the normal free trial." %>
        </p>
      </div>
      <p class="eyebrow">Self-serve launch</p>
      <h1>Claim your URL and launch a page people can act on.</h1>
      <p class="lead">
        Create a search-friendly bio page with links, lead capture, analytics, and a clean public URL.
        The first <%= founderOffer.limit %> users get lifetime access. Everyone after that starts with a <%= trialDays %>-day free trial.
      </p>
      <div class="feature-list">
        <div class="feature-item">Collect names, emails, and messages from your page</div>
        <div class="feature-item">See views, clicks, leads, and top-performing links</div>
        <div class="feature-item">Publish at myurlc.com/your-name in minutes</div>
      </div>
    </section>

    <section class="card auth-form-card">
      <p class="eyebrow">Create account</p>
      <h2>Start your myurlc.com page</h2>
      <p class="field-hint">
        <%= founderOffer.is_open
          ? `Join now and you could still lock in a free-for-life founder slot.`
          : `${trialDays}-day free trial, then ${planPriceDisplay}.` %>
      </p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <% if (info) { %>
        <div class="success"><%= info %></div>
      <% } %>

      <form method="POST" action="/signup" class="form-stack">
        <input type="hidden" name="starter_template" value="<%= values.starter_template || 'service' %>" data-starter-template-input />

        <div class="starter-template-panel">
          <label>Start with a page type</label>
          <div class="starter-picker">
            <% starterTemplateOptions.forEach(option => { %>
              <button class="starter-choice <%= (values.starter_template || 'service') === option.value ? 'is-active' : '' %>" type="button" data-template-choice="<%= option.value %>">
                <strong><%= option.label %></strong>
                <span><%= option.description %></span>
              </button>
            <% }) %>
          </div>
        </div>

        <div class="form-grid two">
          <div>
            <label>Full name</label>
            <input name="full_name" value="<%= values.full_name || '' %>" required />
          </div>
          <div>
            <label>Business name</label>
            <input name="business_name" value="<%= values.business_name || '' %>" required />
          </div>
        </div>

        <label>Email</label>
        <input name="email" type="email" value="<%= values.email || '' %>" required />

        <label>Public username</label>
        <div class="claim-input-shell">
          <span>myurlc.com/</span>
          <input name="slug" value="<%= values.slug || '' %>" placeholder="your-brand" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" minlength="3" maxlength="32" autocapitalize="off" spellcheck="false" data-username-check />
        </div>
        <p class="username-status" data-username-status aria-live="polite"></p>
        <p class="field-hint">Use 3-32 lowercase letters, numbers, or hyphens. You can change this in Studio before publishing.</p>

        <label>Password</label>
        <input name="password" type="password" minlength="8" required />
        <p class="field-hint">Use at least 8 characters.</p>

        <label>Referral code</label>
        <input name="referral_code" value="<%= values.referral_code || '' %>" placeholder="Optional referral code" />
        <p class="field-hint">If someone invited you, their code gives them 1 free month when you sign up.</p>

        <button class="btn" type="submit">Create account</button>
      </form>

      <p class="auth-switch">
        Already signed up?
        <a class="text-link" href="/login">Log in</a>
      </p>
    </section>
  </main>
</div>

<%- include("partials/footer") %>
